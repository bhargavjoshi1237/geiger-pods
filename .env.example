# Use the SAME Supabase project and cookie settings as geiger-dash.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_COOKIE_DOMAIN=
# Optional when developing Pods on a different localhost port from Dash.
# Use Dash's actual origin, e.g. http://localhost:3001 when Pods is on 3000.
NEXT_PUBLIC_DASH_URL=
# Server-only; used by @geiger/orm when product migrations are introduced.
STRING_URI=
# Production defaults to /pods to match geiger-dash rewrites.
# GEIGER_BASE_PATH=/pods
