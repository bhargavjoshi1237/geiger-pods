# Use the SAME Supabase project and cookie settings as geiger-dash.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_COOKIE_DOMAIN=
# Optional when developing Pods on a different localhost port from Dash.
# Use Dash's actual origin, e.g. http://localhost:3001 when Pods is on 3000.
NEXT_PUBLIC_DASH_URL=
# Server-only; used by @geiger/orm when product migrations are introduced.
STRING_URI=
# Production defaults to /pods to match geiger-dash rewrites.
# GEIGER_BASE_PATH=/pods

# --- Gateway runtime (gateway/server.mjs, gateway/loader.mjs) ---
# Port the gateway listens on (default 4000).
PORT=
# Supabase URL for the gateway loader (falls back to NEXT_PUBLIC_SUPABASE_URL).
# Required when NODE_ENV=production.
SUPABASE_URL=
# Service-role key for the gateway (read-only for config, insert-only for telemetry).
# Server only, never in a client bundle. Required when NODE_ENV=production.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC pepper for API-key lookups (value_hmac). Required when NODE_ENV=production.
PODS_KEY_PEPPER=
# Vault master keys: JSON map { "<kid>": "<base64 32 bytes>" }.
# Required when NODE_ENV=production.
PODS_VAULT_KEYS=
# Which kid in PODS_VAULT_KEYS encrypts new secret versions.
# Required when NODE_ENV=production.
PODS_VAULT_ACTIVE_KID=
# Shared KV store (any Redis-protocol server, e.g. Upstash). Empty means in-memory.
PODS_KV_URL=
# Canonical gateway domain for host-based routing (e.g. *.gw.geigerpods.app).
PODS_GATEWAY_DOMAIN=
# Set to 1 to enable path-based routing (/apiId/stage/...) for local/dev.
PODS_GATEWAY_PATH_ROUTING=
# Test-only SSRF escape hatch for loopback upstreams. Must NOT be set when NODE_ENV=production.
PODS_ALLOW_LOOPBACK=
